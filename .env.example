# 不配置 TESLAMATE_API_URL 时只提供演示数据。
HOST=127.0.0.1
PORT=8776
TESLAMATE_API_URL=
CAR_ID=1

# 真实模式：随机生成至少32位，勿提交到Git或发给他人。
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_ACCESS_TOKEN=

# 可选：TeslaMateApi前方反向代理的完整Authorization头，例如Basic ...。
# 不是Tesla账号的refresh token/access token，也不是上游仅保护控车接口的API_TOKEN。
UPSTREAM_AUTHORIZATION=

# 可选：Photon 兼容的街道地址解析服务；启用后会向该服务发送车辆坐标。
# https://photon.komoot.io 仅适合单车低频试用，无可用性保证。
GEOCODER_URL=

# 可选：腾讯 Web 服务 Key，仅存服务端；用于行程端点地址与街道轨迹底图。
# 启用后会将行程端点及轨迹坐标发送至 apis.map.qq.com。
TENCENT_MAP_KEY=
TENCENT_MAP_SECRET=
